# AWS (or server) — copy to .env
# After TLS at a load balancer, set public URLs below.

JWT_SECRET_KEY=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Public URL users and OAuth see for the API (https in production)
APP_BASE_URL=https://api.example.com

# Public URL of the SPA on S3/CloudFront (OAuth "return to app" / links)
FRONTEND_BASE_URL=https://d1234567890.cloudfront.net

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redis: localhost bind by default. For mini PC → AWS, use VPN or (lab only):
# REDIS_PORT_MAPPING=0.0.0.0:6379:6379
REDIS_PORT_MAPPING=127.0.0.1:6379:6379

# WEB_HTTP_PORT=80
# WEB_ALT_PORT=8000
