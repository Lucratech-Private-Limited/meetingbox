ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# OpenAI API key for upload-audio transcription (Whisper). Summarization still uses Anthropic above.
OPENAI_API_KEY=sk-your-openai-key-here
# Optional: override Whisper model (default whisper-1).
# OPENAI_TRANSCRIBE_MODEL=whisper-1

# Optional: override default models/settings in services
AI_MODEL=claude-sonnet-4-20250514
AI_MAX_TOKENS=2000

# Local LLM model for Ollama (used by "Summarize Locally" button)
# Options: phi3:mini (best quality/size ratio, ~2.5GB RAM), qwen2.5:3b
# You must pull the model first: docker compose exec ollama ollama pull phi3:mini
LOCAL_LLM_MODEL=phi3:mini

# Set to "true" to use local Ollama for summarization, "false" for Anthropic Claude
USE_LOCAL_LLM=true

# JWT secret for user authentication (REQUIRED in production).
# Generate one with: openssl rand -hex 32
JWT_SECRET_KEY=replace_with_a_strong_random_secret

# Google OAuth2 (for Gmail + Calendar integrations)
# 1. Go to: https://console.cloud.google.com/apis/credentials
# 2. Create OAuth client ID with type: "Web application"
# 3. Under "Authorized redirect URIs", add:
#      http://localhost:8000/api/integrations/gmail/callback
#      http://localhost:8000/api/integrations/calendar/callback
#    (replace localhost:8000 with your APP_BASE_URL if different)
# 4. Enable Gmail API and Google Calendar API in your project
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base URL of the web backend (used to build OAuth redirect URIs)
# Set this to the URL you access MeetingBox from, e.g.:
#   http://meetingbox.local:8000  or  http://192.168.1.100:8000
APP_BASE_URL=http://localhost:8000

# Optional explicit frontend URL for OAuth callback redirects (defaults to APP_BASE_URL)
FRONTEND_BASE_URL=http://localhost:8000

# Whisper.cpp transcription tuning
# Path inside the container to the GGML model file.
# Default is the medium model bundled in the image. For faster transcription on
# CPU, download a smaller model to data/transcripts/models/ and point here:
#   ggml-tiny.en.bin  — fastest, English only (~75 MB)
#   ggml-base.bin     — good balance (~140 MB)
# WHISPER_MODEL_PATH=/data/transcripts/models/ggml-tiny.en.bin
WHISPER_MODEL_PATH=/app/whisper.cpp/models/ggml-tiny.bin

# Number of CPU threads for Whisper inference (default 4)
WHISPER_THREADS=4

# Audio input device selection (if auto-detect picks wrong mic; see Known Issue #9 in HANDOVER)
# Run ./scripts/list_audio_devices.sh to list available devices.
# AUDIO_INPUT_DEVICE_INDEX=1
# AUDIO_INPUT_DEVICE_NAME=USB

# Upload finalized WAV to backend API when meeting stops (host/docker audio capture).
UPLOAD_AUDIO_ON_STOP=1
# Docker audio service should use http://web:8000/... ; host script default is localhost.
UPLOAD_AUDIO_API_URL=http://web:8000/api/meetings/upload-audio
# Seconds to wait for POST /upload-audio (includes cloud transcription + summary in one request).
UPLOAD_AUDIO_TIMEOUT_SECONDS=1200

