# Copy to .env (same folder as docker-compose.yml). Compose loads .env automatically.
#
# The server stack (FastAPI under server/web/, Alembic, Docker compose in server/)
# stands alone: clone or deploy only this repo and set FRONTEND_DIST / DATA_ROOT to
# match where you build the SPA and store uploads. It does not depend on mini-pc/.
#
# --- Monorepo layout (frontend/ and data/ live next to server/) ---
FRONTEND_DIST=../frontend/dist
DATA_ROOT=../data
#
# --- Standalone server repo (everything under one package) ---
# FRONTEND_DIST=./frontend/dist
# DATA_ROOT=./data

JWT_SECRET_KEY=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Long recordings are split before Whisper transcription to stay below the per-file cap.
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_TRANSCRIBE_PROMPT=This is a multilingual meeting. Speakers may switch between English, Telugu, Hindi, and other Indian languages. Transcribe all speech accurately in the language spoken. Preserve names, numbers, dates, product names, English technical terms, and code-mixed phrases. Do not translate during transcription.
# Leave blank for auto-detect. Only set this for fixed-language deployments, e.g. te or hi.
# OPENAI_TRANSCRIBE_LANGUAGE=
# OPENAI_TRANSCRIBE_CHUNK_SECONDS=600
# OPENAI_TRANSCRIBE_MAX_BYTES=25165824
# MEETINGBOX_MAX_UPLOAD_BYTES=2147483648
# MEETINGBOX_MAX_MEETING_UPLOAD_SECONDS=28800

APP_BASE_URL=https://api.example.com
FRONTEND_BASE_URL=https://your-spa-or-same-host.example.com
# OAUTH_PUBLIC_BASE_URL=https://api.example.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redis: appliance recorder needs to reach this. Default binds localhost only.
REDIS_PORT_MAPPING=127.0.0.1:6379:6379

# WEB_HTTP_PORT=80
# WEB_ALT_PORT=8000
