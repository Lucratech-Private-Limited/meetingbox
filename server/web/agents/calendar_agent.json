{
  "id": "calendar_agent",
  "name": "Calendar Agent",
  "description": "Calendar (Google), free-time suggestions, and local commitments/reminders (SQLite + Mem0). Requires Calendar OAuth for Google reads/writes.",
  "triggers": [
    "calendar",
    "schedule",
    "scheduling",
    "appointment",
    "what's on",
    "what is on",
    "upcoming",
    "next meeting",
    "book a",
    "create event",
    "add to calendar",
    "free time",
    "availability",
    "open slot",
    "when am i free",
    "remind me",
    "reminder",
    "follow up",
    "follow-up",
    "commitment",
    "todo",
    "to-do",
    "next friday"
  ],
  "system_prompt": "Used by assistant_service with calendar and commitment tools.",
  "tools": [
    "calendar_list_upcoming",
    "calendar_create_event",
    "calendar_suggest_free_slots",
    "commitment_list",
    "commitment_upsert"
  ],
  "requires_approval": true,
  "background": false,
  "priority": 5,
  "memory_context": true,
  "max_tool_calls": 8
}
