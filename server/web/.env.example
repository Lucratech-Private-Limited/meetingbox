# Copy to .env and fill in values. The web app loads server/web/.env automatically.

JWT_SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=

# OpenAI Realtime voice assistant (mini-pc / clients that support WebSocket + PCM16).
# When off, POST /api/voice/realtime/* returns 503.
# MEETINGBOX_REALTIME_VOICE_ENABLED=1
# Model id for client_secret session (e.g. gpt-realtime, gpt-realtime-mini; consult OpenAI Realtime docs).
# OPENAI_REALTIME_MODEL=gpt-realtime
# For speech-optimized Realtime models (see OpenAI docs), e.g.:
# OPENAI_REALTIME_MODEL=gpt-realtime-whisper

# API and dashboard origins (browser + server)
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
# Split deploy: SPA on S3/CloudFront + API on AWS — set both to public https URLs, and build
# frontend with VITE_API_URL (see frontend/.env.production.example) and web-stack/README.md.

# Google OAuth redirect (fixes "device_id and device_name are required for private IP")
# Google rejects redirect URIs like http://192.168.1.17:8000/...
# Set this to a hostname that still points at your server, e.g.:
#   1) Add to /etc/hosts on every client:  192.168.1.17  meetingbox.home
#   2) OAUTH_PUBLIC_BASE_URL=http://meetingbox.home:8000
#   3) In Google Cloud Console -> OAuth client -> Authorized redirect URIs add:
#      http://meetingbox.home:8000/api/auth/google/callback
# Same-machine dev: use http://127.0.0.1:8000 here and in Google Console.
#OAUTH_PUBLIC_BASE_URL=http://meetingbox.home:8000

# Security / hardening (recommended for demos and production)
# MEETINGBOX_STRICT_STARTUP=1
# Same JWT requirement as strict startup (alias intent for deploy scripts).
# MEETINGBOX_PRODUCTION=1
# Fail API start if JWT_SECRET_KEY is missing (set with the real secret above).

# Reject startup unless MEETINGBOX_CORS_ORIGINS lists real origins (no "*"). Use for internet-facing APIs.
# MEETINGBOX_REQUIRE_EXPLICIT_CORS=1

# Comma-separated browser origins allowed for CORS (omit or empty = allow all "*").
# Example: MEETINGBOX_CORS_ORIGINS=https://app.example.com,http://localhost:5173
# MEETINGBOX_CORS_ORIGINS=

# WebSocket /ws: if set, clients must connect with ?token=<same value> (e.g. service mesh / scripts).
# MEETINGBOX_WS_SHARED_SECRET=
# If set, require a valid dashboard JWT or paired device token. Browser clients cannot send Authorization on
# WebSocket open; the SPA appends ?access_token= from the same localStorage key as REST (see useWebSocket).
# If both this and MEETINGBOX_WS_SHARED_SECRET are set, either valid ?token= or valid access_token/Bearer is accepted.
# MEETINGBOX_WS_REQUIRE_AUTH=1

# GET /api/system/status normally public; set to require a logged-in user (hides host CPU/RAM from anonymous callers).
# MEETINGBOX_SYSTEM_STATUS_REQUIRE_AUTH=1

# Assistant POST /api/assistant/intent requires Authorization by default (unsafe for public internet if disabled).
# MEETINGBOX_ASSISTANT_ALLOW_ANON=1

# Optional
# MEETINGBOX_DB_PATH=/data/transcripts/meetings.db
# RECORDINGS_DIR=/opt/meetingbox/data/audio/recordings
# REDIS_HOST=127.0.0.1
# STATIC_DIR=/path/to/frontend/dist
# MEETINGBOX_AUDIT_RETENTION_DAYS=90

# Mem0 long-term memory (user_id-scoped). Disable entirely:
# MEETINGBOX_MEM0_DISABLE=1
# Block writes only:
# MEETINGBOX_MEM0_WRITES_DISABLE=1
# After meeting summarize, ingest summary text (user-scoped):
# MEETINGBOX_MEM0_AUTO_INGEST_SUMMARY=1
# Optional ingest after successful assistant tool reads (off by default; can increase storage/API cost):
# MEETINGBOX_MEM0_INGEST_CALENDAR=1
# MEETINGBOX_MEM0_INGEST_GMAIL=1
# MEETINGBOX_MEM0_INGEST_CHAT=1
# Commitments/reminders saved via assistant: mirror into Mem0 (default on in code; set 0 to disable):
# MEETINGBOX_MEM0_INGEST_COMMITMENTS=0

# Multiple uvicorn workers: recording/redis coherence is only validated for single-worker; suppress warning:
# MEETINGBOX_I_ACKNOWLEDGE_MULTI_WORKER_RECORDING=1

# Admin APIs (role=admin JWT): memory inspection, meetings summary, access log, POST /api/admin/backup/database
# MEETINGBOX_BACKUP_DIR=/data/backups

# Gmail: optional full search string used when listing recent messages with empty `q` (assistant + integrations).
# Default is Primary + calendar invite heuristics when unset.
# MEETINGBOX_GMAIL_LIST_DEFAULT_Q=(in:inbox category:primary) OR (in:inbox filename:ics)
# MEETINGBOX_GMAIL_LIST_MERGE=0

# Strip obvious security/billing/newsletter rows after fetch (transactional From + noisy Subject). Disable with 0.
# MEETINGBOX_GMAIL_POSTFILTER=0

# Personal inbox filter (default on): Gmail labelIds (Promotions/Social/Forums/Updates), List-Unsubscribe / List-Id,
# Precedence / Auto-Submitted / ESP headers, and automated From local-parts — not a static domain blocklist.
# MEETINGBOX_GMAIL_STRICT_INBOX=0  # looser list query merge only; soft path still hides bulk when POSTFILTER is on.

# Optional: comma-separated domains to always hide (e.g. internal mailers). Empty by default.
# MEETINGBOX_GMAIL_BLOCK_DOMAINS=news.example.com,alerts.example.com

# Optional
