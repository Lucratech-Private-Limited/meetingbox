# Copy to .env and fill in values. The web app loads server/web/.env automatically.

JWT_SECRET_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=
# Long recordings are split before Whisper transcription to stay below the per-file cap.
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_TRANSCRIBE_PROMPT=This is a multilingual meeting. Speakers may switch between English, Telugu, Hindi, and other Indian languages. Transcribe all speech accurately in the language spoken. Preserve names, numbers, dates, product names, English technical terms, and code-mixed phrases. Do not translate during transcription.
# Leave blank for auto-detect. Only set this for fixed-language deployments, e.g. te or hi.
# OPENAI_TRANSCRIBE_LANGUAGE=
# OPENAI_TRANSCRIBE_CHUNK_SECONDS=600
# OPENAI_TRANSCRIBE_MAX_BYTES=25165824
# MEETINGBOX_MAX_UPLOAD_BYTES=2147483648
# MEETINGBOX_MAX_MEETING_UPLOAD_SECONDS=28800
# Intent router (orchestrator): maps user message → specialist agent. Uses the same key as TTS/Whisper.
# If unset, falls back to Claude (ANTHROPIC_API_KEY / AI_MODEL).
# OPENAI_ROUTER_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=

# ---------- TTS (device voice quality) ----------
# Voice used when the device calls POST /api/tts/speak.
# Options: alloy | ash | coral | echo | fable | nova | onyx | sage | shimmer
# nova = warm, friendly female voice (recommended default)
# onyx = deep, authoritative male voice
OPENAI_TTS_VOICE=shimmer
# Model: tts-1 (faster, real-time optimised) or tts-1-hd (higher fidelity)
OPENAI_TTS_MODEL=tts-1

# OpenAI Realtime voice assistant (mini-pc opens wss://api.openai.com/v1/realtime with the minted secret).
# Server returns 503 for /api/voice/realtime/* when off.
MEETINGBOX_REALTIME_VOICE_ENABLED=1

# Model id for the session (announced May 2025 OpenAI voice-intelligence models):
#   gpt-realtime-2         — GPT-5-class speech-to-speech; answers questions, talks back  ← USE THIS
#   gpt-realtime-translate — live translation (70+ → 13 languages); NOT a general assistant
#   gpt-realtime-whisper   — streaming STT only; does NOT speak back
OPENAI_REALTIME_MODEL=gpt-realtime-2

# Built-in voices for speech-to-speech (differs from TTS names): alloy, ash, ballad, coral, echo,
# sage, shimmer, verse, marin, cedar. marin is a good default for natural, low-latency feel.
# If OPENAI_REALTIME_VOICE is omitted, MeetingBox defaults to marin; falls back to OPENAI_TTS_VOICE next.
OPENAI_REALTIME_VOICE=marin

# API and dashboard origins (browser + server)
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
# Split deploy: SPA on S3/CloudFront + API on AWS — set both to public https URLs, and build
# frontend with VITE_API_URL (see frontend/.env.production.example) and web-stack/README.md.

# Google OAuth redirect (fixes "device_id and device_name are required for private IP")
# Google rejects redirect URIs like http://192.168.1.17:8000/...
# Set this to a hostname that still points at your server, e.g.:
#   1) Add to /etc/hosts on every client:  192.168.1.17  meetingbox.home
#   2) OAUTH_PUBLIC_BASE_URL=http://meetingbox.home:8000
#   3) In Google Cloud Console -> OAuth client -> Authorized redirect URIs add:
#      http://meetingbox.home:8000/api/auth/google/callback
# Same-machine dev: use http://127.0.0.1:8000 here and in Google Console.
#OAUTH_PUBLIC_BASE_URL=http://meetingbox.home:8000

# Security / hardening (recommended for demos and production)
# MEETINGBOX_STRICT_STARTUP=1
# Same JWT requirement as strict startup (alias intent for deploy scripts).
# MEETINGBOX_PRODUCTION=1
# Fail API start if JWT_SECRET_KEY is missing (set with the real secret above).

# Reject startup unless MEETINGBOX_CORS_ORIGINS lists real origins (no "*"). Use for internet-facing APIs.
# MEETINGBOX_REQUIRE_EXPLICIT_CORS=1

# Comma-separated browser origins allowed for CORS (omit or empty = allow all "*").
# Example: MEETINGBOX_CORS_ORIGINS=https://app.example.com,http://localhost:5173
# MEETINGBOX_CORS_ORIGINS=

# WebSocket /ws: if set, clients must connect with ?token=<same value> (e.g. service mesh / scripts).
# MEETINGBOX_WS_SHARED_SECRET=
# If set, require a valid dashboard JWT or paired device token. Browser clients cannot send Authorization on
# WebSocket open; the SPA appends ?access_token= from the same localStorage key as REST (see useWebSocket).
# If both this and MEETINGBOX_WS_SHARED_SECRET are set, either valid ?token= or valid access_token/Bearer is accepted.
# MEETINGBOX_WS_REQUIRE_AUTH=1

# GET /api/system/status normally public; set to require a logged-in user (hides host CPU/RAM from anonymous callers).
# MEETINGBOX_SYSTEM_STATUS_REQUIRE_AUTH=1

# Assistant POST /api/assistant/intent requires Authorization by default (unsafe for public internet if disabled).
# MEETINGBOX_ASSISTANT_ALLOW_ANON=1

# ---------------------------------------------------------------------------
# Web Search (voice assistant "web_search" tool)
# ---------------------------------------------------------------------------
# Brave Search API — free tier: 2000 queries/month, no credit card required.
# Sign up at https://brave.com/search/api/ → Independent plan → copy the key.
# Without this key, the voice assistant falls back to DuckDuckGo instant answers
# (good for factual/definition queries; no full web results).
# BRAVE_SEARCH_API_KEY=

# Optional
# MEETINGBOX_DB_PATH=/data/transcripts/meetings.db
# RECORDINGS_DIR=/opt/meetingbox/data/audio/recordings
# REDIS_HOST=127.0.0.1
# STATIC_DIR=/path/to/frontend/dist
# MEETINGBOX_AUDIT_RETENTION_DAYS=90

# ---------------------------------------------------------------------------
# Mem0 long-term memory — self-hosted (pgvector + Neo4j via Docker)
# ---------------------------------------------------------------------------
# Self-hosted stack runs alongside MeetingBox in docker-compose.yml.
# Without these vars, Memory() initialization fails silently and the assistant
# has no long-term recall (core tasks like email/calendar still work, but the
# assistant cannot remember past preferences or conversation context).
#
# MEM0_PGVECTOR_HOST: service name in docker-compose (default: mem0-postgres)
MEM0_PGVECTOR_HOST=mem0-postgres
MEM0_PGVECTOR_PORT=5432
MEM0_PGVECTOR_USER=postgres
MEM0_PGVECTOR_PASSWORD=change-me-strong-password
MEM0_PGVECTOR_DB=postgres
#
# MEM0_NEO4J_URI: bolt URI for the Neo4j service (default: bolt://mem0-neo4j:7687)
MEM0_NEO4J_URI=bolt://mem0-neo4j:7687
MEM0_NEO4J_USERNAME=neo4j
MEM0_NEO4J_PASSWORD=change-me-strong-password
# LLM used by Mem0 for fact extraction (default: gpt-4o-mini).
# mem0ai 2.0.2 defaults to gpt-5-mini which dropped max_tokens support; override here.
# MEM0_LLM_MODEL=gpt-4o-mini

# Disable Mem0 entirely (useful during initial setup before DBs are ready):
# MEETINGBOX_MEM0_DISABLE=1

# Block writes only (read existing memories but stop adding new ones):
# MEETINGBOX_MEM0_WRITES_DISABLE=1

# Neo4j is optional: when set, Mem0 initializes with pgvector only if Neo4j is unavailable.
# Safe to enable — graph queries are skipped, semantic search still works.
MEM0_NEO4J_OPTIONAL=1

# Ingest meeting summary text into Mem0 after each meeting is summarized (recommended ON):
MEETINGBOX_MEM0_AUTO_INGEST_SUMMARY=1

# Ingest snapshots after successful tool reads — recommended ON so the voice assistant can
# recall calendar and email context via Mem0 (memory_search tool):
MEETINGBOX_MEM0_INGEST_CALENDAR=1
MEETINGBOX_MEM0_INGEST_GMAIL=1
# Chat turn ingest (assistant Q&A saved to Mem0 for recall — increases OpenAI usage):
MEETINGBOX_MEM0_INGEST_CHAT=1

# Mirror commitments/reminders into Mem0 (default ON — set 0 to disable):
# MEETINGBOX_MEM0_INGEST_COMMITMENTS=0

# Push structured meeting SQLite rows (summaries, discussion_points, extracted actions) into Mem0
# after summarize — helps Realtime/memory_search recall action items and talking points:
MEETINGBOX_MEM0_INGEST_MEETING_ARTIFACTS=1

# Log assistant queue approve/reject/fail outcomes into Mem0 (short digest per event):
MEETINGBOX_MEM0_INGEST_PENDING_OUTCOMES=1

# Background analysis jobs: daily meeting digest + cross-meeting synthesis.
# Runs at 02:00 UTC daily. Safe to enable — adds ~50ms startup time.
MEETINGBOX_ANALYSIS_ENABLED=1

# Background user profiler: learns user interests, personality, and work patterns.
# Runs daily at 03:00 UTC and after each meeting summarize (fire-and-forget, idempotent).
# Stores a structured profile in Mem0 (agent_id=user_profile) injected into every voice session.
# Requires MEETINGBOX_MEM0_AUTO_INGEST_SUMMARY=1 and active Mem0 for best results.
# Cost: ~$0.002/user/day with gpt-4o-mini. Runs only in background — zero impact on live requests.
MEETINGBOX_USER_PROFILER_ENABLED=1

# LLM model used for user profile synthesis and preference inference from rejections.
# gpt-4o-mini: good quality, low cost (recommended). gpt-4o: highest quality, higher cost.
# MEETINGBOX_PROFILER_MODEL=gpt-4o-mini
# ---------------------------------------------------------------------------

# Multiple uvicorn workers: recording/redis coherence is only validated for single-worker; suppress warning:
# MEETINGBOX_I_ACKNOWLEDGE_MULTI_WORKER_RECORDING=1

# Admin APIs (role=admin JWT): memory inspection, meetings summary, access log, POST /api/admin/backup/database
# MEETINGBOX_BACKUP_DIR=/data/backups

# Gmail: optional full search string used when listing recent messages with empty `q` (assistant + integrations).
# Default is Primary + calendar invite heuristics when unset.
# MEETINGBOX_GMAIL_LIST_DEFAULT_Q=(in:inbox category:primary) OR (in:inbox filename:ics)
# MEETINGBOX_GMAIL_LIST_MERGE=0

# Strip obvious security/billing/newsletter rows after fetch (transactional From + noisy Subject). Disable with 0.
# MEETINGBOX_GMAIL_POSTFILTER=0

# Personal inbox filter (default on): Gmail labelIds (Promotions/Social/Forums/Updates), List-Unsubscribe / List-Id,
# Precedence / Auto-Submitted / ESP headers, and automated From local-parts — not a static domain blocklist.
# MEETINGBOX_GMAIL_STRICT_INBOX=0  # looser list query merge only; soft path still hides bulk when POSTFILTER is on.

# Optional: comma-separated domains to always hide (e.g. internal mailers). Empty by default.
# MEETINGBOX_GMAIL_BLOCK_DOMAINS=news.example.com,alerts.example.com

# Optional
