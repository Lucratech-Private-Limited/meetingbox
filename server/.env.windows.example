# Windows instance overrides for docker-compose.windows.yml
# =========================================================
#
# The Windows server instance SHARES the main stack's .env for all secrets and
# paths (JWT_SECRET_KEY, API keys, DATA_ROOT, FRONTEND_DIST, MEM0_*, etc.).
# Run it with the SAME env file as the main stack:
#
#   docker compose -f docker-compose.windows.yml --env-file .env up -d
#
# So you do NOT need a separate secrets file — just append the few knobs below
# to your existing server/.env (or export them) to control the Windows instance.

# Host port the Windows exe connects to (container always listens on 8000).
WINDOWS_WEB_PORT=8100

# Uvicorn workers for the Windows instance (kept lower than main by default
# because both instances write to the same shared SQLite database).
WINDOWS_WEB_CONCURRENCY=4

# Marker exposed to the app so logs / future Windows-only endpoints can tell
# which instance they run in. Leave as "windows".
MEETINGBOX_INSTANCE=windows

# Docker network of the MAIN stack that this instance joins so it can reach
# "redis", "mem0-postgres" and "mem0-neo4j". Default assumes the main stack was
# started from docker-compose.yml (project "meetingbox-server"). If
# `docker network ls` shows a different name, set it here.
SHARED_NETWORK_NAME=meetingbox-server_meetingbox-server-net

# Optional: point the Windows instance at a different Redis host/service name.
# WINDOWS_REDIS_HOST=redis
