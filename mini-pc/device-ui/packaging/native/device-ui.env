# MeetingBox native device UI runtime config.
# Installed to /etc/meetingbox/device-ui.env by the .deb package.

# Local display created by xinit/openbox or another minimal X11 session.
DEVICE_UI_DISPLAY=:0

# Kiosk defaults. Set FULLSCREEN=0 only for desktop debugging.
FULLSCREEN=1
SHOW_MOUSE_CURSOR=0

# Match your physical display. You can also set MEETINGBOX_SYNC_DISPLAY_FROM_XRANDR=1.
DISPLAY_WIDTH=1024
DISPLAY_HEIGHT=600
# MEETINGBOX_SYNC_DISPLAY_FROM_XRANDR=1

# Backend / dashboard.
# Must match the cloud dashboard where Gmail/Calendar integrations are connected.
BACKEND_URL=https://meetingboxai.lucratechsol.com
BACKEND_WS_URL=wss://meetingboxai.lucratechsol.com/ws
DASHBOARD_URL=https://meetingboxai.lucratechsol.com/
MOCK_BACKEND=0

# Audio_level / lifecycle events from the in-process audio_capture
# child arrive via stdout (parsed by audio_supervisor) — no Redis needed.
AUDIO_INPUT_DEVICE_INDEX=
AUDIO_INPUT_DEVICE_NAME=

# Realtime voice latency: keep a pre-warmed OpenAI Realtime session connected
# and held in standby so the wake word ACTIVATES it instantly, instead of
# minting + connecting + prefilling on every wake (~3.4 s saved). Idle held
# sessions stream no audio, so they incur no token cost. Set to 0 to fall back
# to cold per-wake sessions (previous behavior).
REALTIME_WARM_STANDBY=1

# Spoken "I'm listening" wake acknowledgment. With warm standby this fires on
# the pre-warmed session at wake, so it returns in ~1s instead of 6-7s. Set 0
# to disable the spoken cue (the on-screen listening animation still shows).
REALTIME_WAKE_GREETING_ENABLED=1

# Live on-screen captions WHILE you speak, using the on-device Vosk wake-word
# model on the outgoing mic audio. OpenAI's transcript only arrives after you
# stop (post end-of-turn), so this fills the gap with rough partial text that is
# replaced by the accurate transcript once the turn commits. Display-only — it
# does not affect how fast the assistant responds. Set 0 to disable.
REALTIME_LIVE_CAPTION=1

# Optional device auth token. Prefer pairing flow so this lands in /opt/meetingbox/data/config.
# DEVICE_AUTH_TOKEN=mbd_...
