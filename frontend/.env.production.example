# Copy to .env.production before: npm run build
# Used when the SPA is hosted on S3/CloudFront and the API runs elsewhere (e.g. AWS EC2/ECS).
#
# Frontend-only repo: only VITE_* below is required at build time; no server or mini-pc paths.

# Required: public origin of the FastAPI stack (no trailing slash)
VITE_API_URL=https://api.example.com

# Optional: full WebSocket URL (defaults to wss://<host-from-VITE_API_URL>/ws)
# VITE_WS_URL=wss://api.example.com/ws
