# Copy to .env.production before: npm run build
# Used when the SPA is hosted on S3/CloudFront and the API runs elsewhere (e.g. AWS EC2/ECS).
#
# Frontend-only repo: only VITE_* below is required at build time; no server or mini-pc paths.

# Same host as the SPA (nginx serves static + proxies /api): leave VITE_API_URL unset.
#
# Split hosting only (SPA on CDN/S3, API elsewhere): set the API origin — NOT the CDN URL.
# Wrong value causes 403 Forbidden from the static bucket on /api/* requests.
# VITE_API_URL=https://api.example.com

# Optional: full WebSocket URL (defaults to wss://<host-from-VITE_API_URL>/ws)
# VITE_WS_URL=wss://api.example.com/ws

# Optional: weather is fetched directly from Open-Meteo by the frontend.
# Defaults are Bengaluru.
# VITE_WEATHER_CITY=Bengaluru
# VITE_WEATHER_LAT=12.9716
# VITE_WEATHER_LON=77.5946
