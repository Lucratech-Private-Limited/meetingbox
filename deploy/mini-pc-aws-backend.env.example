# Mini PC — point recorder + device UI at the AWS (cloud) API stack.
# Copy values into your shell, systemd, or device-ui environment.

# --- Host audio (run_audio_capture.sh) ---
# Redis must be the same instance the cloud `web` container uses (see web-stack REDIS_PORT_MAPPING / VPN).
export REDIS_HOST=10.0.1.50
export REDIS_PORT=6379

# HTTPS public API (nginx or ALB in front of FastAPI)
export UPLOAD_AUDIO_API_URL=https://api.example.com/api/meetings/upload-audio

# If the device uploads with Bearer auth:
# export DEVICE_AUTH_TOKEN=mbd_...

# --- Device UI (Kivy) ---
# BACKEND_URL=https://api.example.com
# BACKEND_WS_URL=wss://api.example.com/ws
