# Mini PC — point recorder + device UI at the AWS (cloud) API stack.
# Prefer: mini-pc/.env.example → mini-pc/.env (server env: server/.env.example).
# This file remains as a short shell-export cheat sheet.

# --- Host audio (run_audio_capture.sh) ---
# Redis must be the same instance the cloud `web` container uses (see web-stack REDIS_PORT_MAPPING / VPN).
export REDIS_HOST=10.0.1.50
export REDIS_PORT=6379

# HTTPS public API (nginx or ALB in front of FastAPI)
export UPLOAD_AUDIO_API_URL=https://api.example.com/api/meetings/upload-audio

# If the device uploads with Bearer auth:
# export DEVICE_AUTH_TOKEN=mbd_...

# --- Device UI (Kivy) — HTTP API + WebSocket to same host as nginx/frontend ---
# export BACKEND_URL=http://meetingboxai.duckdns.org:8000
# export BACKEND_WS_URL=ws://meetingboxai.duckdns.org:8000/ws
# export DASHBOARD_URL=http://meetingboxai.duckdns.org:8000/
# After pairing, the UI stores DEVICE_AUTH_TOKEN; avoid stale DEVICE_AUTH_TOKEN in env (see config.py).
