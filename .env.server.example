# Rename to .env in the repo root (same folder as docker-compose.server.yml).
# Docker Compose loads .env automatically for variable substitution.

JWT_SECRET_KEY=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Public https URLs in production
APP_BASE_URL=https://api.example.com
FRONTEND_BASE_URL=https://your-spa-on-s3-or-cloudfront.example.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redis: mini PC recorder needs this host. Local-only default; remote: use VPN or (lab) 0.0.0.0:6379
REDIS_PORT_MAPPING=127.0.0.1:6379:6379

# WEB_HTTP_PORT=80
# WEB_ALT_PORT=8000
